{
  "datasets": [
    {
      "name": "ds_sales",
      "displayName": "Vendas (obt_sales)",
      "queryLines": [
        "SELECT venda_id, data_venda, quantidade, valor_total, COALESCE(empresa_detentora_registro, 'Não informado') AS fabricante, COALESCE(categoria_regulatoria, 'Não informado') AS tipo_medicamento, COALESCE(uf, 'Não informado') AS uf, COALESCE(cidade, 'Não informado') AS cidade, canal_venda FROM eurofarma.gold.obt_sales"
      ]
    },
    {
      "name": "ds_map",
      "displayName": "Vendas geolocalizadas",
      "queryLines": [
        "SELECT venda_id, data_venda, quantidade, valor_total, COALESCE(empresa_detentora_registro, 'Não informado') AS fabricante, COALESCE(categoria_regulatoria, 'Não informado') AS tipo_medicamento, COALESCE(uf, 'Não informado') AS uf, COALESCE(cidade, 'Não informado') AS cidade, nome_fantasia, latitude, longitude FROM eurofarma.gold.obt_sales WHERE latitude IS NOT NULL AND longitude IS NOT NULL"
      ]
    }
  ],
  "pages": [
