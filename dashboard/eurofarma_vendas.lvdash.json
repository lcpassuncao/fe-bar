              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(quantidade)",
                  "displayName": "Quantidade Vendida"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Quantidade Vendida"
