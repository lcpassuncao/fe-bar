          "widget": {
            "name": "kpi-quantidade",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_sales",
                  "fields": [
                    {
                      "name": "sum(quantidade)",
                      "expression": "SUM(`quantidade`)"
